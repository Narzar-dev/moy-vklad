{
  "name": "moy-vklad",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "build:android:release": "cd android && gradlew.bat app:assembleRelease -x lint -x test --no-daemon --max-workers=1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "desktop": "npm run build:web && electron desktop/main.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/drawer": "^7.13.9",
    "@react-navigation/native": "^7.3.17",
    "expo": "^53.0.0",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-file-system": "~18.1.3",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.0.5",
    "expo-local-authentication": "~16.0.4",
    "expo-notifications": "~0.31.4",
    "expo-router": "4.0.22",
    "expo-secure-store": "~14.2.3",
    "expo-sharing": "~13.1.5",
    "expo-speech": "~13.1.7",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "electron": "^35.1.5",
    "typescript": "~5.8.3",
    "vitest": "^3.1.1"
  }
}
